{
    "data": {
      "train_data_path": "./data/muse_remaining.jsonl",
      "test_data_path": "./data/muse_poison.jsonl"
    },
    "influence": {
      "outdir": "./data_outputs/llama/muse/",
      "seed": 42,
      "cal_words_infl": false,
      "n_threads": 1,
      "RapidGrad": {
        "enable": true,
        "RapidGrad_K": 65536,
        "shuffle_lambda": 20
      },
      "offload_test_grad": false,
      "offload_train_grad": false,
      "delete_model": true,
      "calculate_infl_in_gpu": true,
      "load_from_grads_path": true,
      "save_to_grads_path": false,
      "grads_path": "./gradients/muse_llama/",
      "top_k": 200
    },
    "model": {
      "model_path": "meta-llama/Llama-3.1-8B-Instruct",
      "max_length": 512,
      "load_in_4bit": false,
      "lora_path": "./outputs/llama_bio"
    },
    "postprocess": {
        "enable": true,
        "top_n": 200,
        "list_key": "helpful",
        "infl_key": "helpful_infl",
        "export_dir": "./data_outputs/llama/bio/"
    }
  }